# ============================================
# REQUIRED: PostgreSQL database connection
# ============================================
# Get a free database from https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# ============================================
# REQUIRED: JWT secret (change this!)
# ============================================
JWT_SECRET="your-very-long-random-secret-key-here"

# ============================================
# OPTIONAL: Admin credentials for seeding
# ============================================
# Used only when running: npx prisma db seed
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YEP@Admin2024!"
